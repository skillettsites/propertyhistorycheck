{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/refresh-price-paid", "schedule": "0 3 1 * *" },
    { "path": "/api/cron/cleanup-cache", "schedule": "0 4 * * *" }
  ],
  "headers": [
    {
      "source": "/api/webhook",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
